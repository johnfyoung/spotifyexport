SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=https://localhost:5000/callback
FLASK_SECRET_KEY=change_me

# Option A: path to the oauth.json generated by `ytmusicapi oauth`
YTMUSIC_OAUTH_FILE=

# Option B: raw headers JSON copied from your browser session
YTMUSIC_COOKIE={"cookie": "VISITOR_INFO1_LIVE=...", "user-agent": "Mozilla/5.0 ..."}
